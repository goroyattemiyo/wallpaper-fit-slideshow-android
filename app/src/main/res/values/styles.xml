<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WallpaperFitSlideshow" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <style name="Text.SectionTitle">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Helper">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Button.Primary" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/accent</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Button.Secondary" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Button.Danger" parent="@android:style/Widget.Material.Button">
        <item name="android:backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/danger</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
