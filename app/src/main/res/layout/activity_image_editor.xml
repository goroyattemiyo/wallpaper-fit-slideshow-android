<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/back_button"
            style="@style/Button.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="← 戻る" />

        <TextView
            android:id="@+id/editor_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/card_surface"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/home_target_button"
            style="@style/Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="ホーム編集中" />

        <Button
            android:id="@+id/lock_target_button"
            style="@style/Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:minHeight="0dp"
            android:text="ロック" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/preview_frame"
        android:elevation="2dp"
        android:gravity="center"
        android:padding="3dp">

        <io.github.goroyattemiyo.wallpaperfitslideshow.ui.WallpaperPreviewView
            android:id="@+id/wallpaper_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#FF000000"
            android:minWidth="120dp"
            android:minHeight="180dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/gesture_status"
        style="@style/Text.Helper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="ホーム / 指で移動・ピンチで縮小/拡大" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_surface"
        android:orientation="vertical"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/contain_button"
                style="@style/Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:text="全体表示" />

            <Button
                android:id="@+id/background_button"
                style="@style/Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:text="背景" />

            <Button
                android:id="@+id/reset_button"
                style="@style/Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:text="リセット" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/save_button"
                style="@style/Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:text="保存して戻る" />

            <Button
                android:id="@+id/apply_button"
                style="@style/Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:text="この1枚をホームへ" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
