<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Wallpaper Fit"
        android:textColor="#BFFFFFFF"
        android:textSize="10sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_current_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="ホーム壁紙なし"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_zoom_out"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_control_background"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="－"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_zoom_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Zoom --"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_zoom_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="━━━━━●━━━━━"
                android:textColor="#D9FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/widget_zoom_in"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_control_background"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="＋"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <Button
            android:id="@+id/widget_zoom_reset"
            android:layout_width="52dp"
            android:layout_height="36dp"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_control_background"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="RESET"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_blur_out"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_control_background"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="－"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_blur_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Blur 0"
                android:textColor="#FFFFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_blur_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="●━━━━━━━━━━"
                android:textColor="#D9FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/widget_blur_in"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_control_background"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="＋"
            android:textAllCaps="false"
            android:textColor="#FFFFFFFF"
            android:textSize="18sp" />

        <TextView
            android:layout_width="52dp"
            android:layout_height="1dp"
            android:layout_marginStart="5dp" />
    </LinearLayout>

</LinearLayout>
